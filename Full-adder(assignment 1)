module top_module(input A[3:0], input B[3:0], input CIN, output SUM[3:0], output COUT);
    wire cout1,cout2,cout3;
    full_adder inst1(A[0] , B[0], CIN, SUM[0], cout1);
    full_adder inst2(A[1] , B[1], cout1, SUM[1], cout2);
    full_adder inst3(A[2] , B[2], cout2, SUM[2], cout3);
    full_adder inst4(A[3] , B[3], cout3, SUM[3], COUT);
endmodule
module full_adder(input a, input b, input cin, output sum , output cout);
	wire c,d;
    assign c=a^b;
    assign d=a&b;
    assign sum=cin^c;
    assign cout=d|(cin&c);
    endmodule
